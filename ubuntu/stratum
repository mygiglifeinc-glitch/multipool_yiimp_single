#!/usr/bin/env bash
#####################################################
# Source code from https://codereview.stackexchange.com/questions/55077/small-bash-script-to-start-and-stop-named-services
# Updated by cryptopool.builders for crypto use...
#####################################################
# Usage: stratum start|stop|restart algo [algo ...]
# Starts/stops the stratum for an algo in a screen named after the algo.

source /etc/multipool.conf
STRATUM_DIR=$STORAGE_ROOT/yiimp/site/stratum

# Algos known to this script. Any other algo works too as long as
# $STRATUM_DIR/config/<algo>.conf exists.
ALGOS=(sha256 sha256t lbry scrypt timetravel bitcore exosis c11 deep x11 x11evo x12 x13 x15 x16r
	x16s x17 x22i aergo xevan hmq1725 nist5 x14 quark whirlpool neoscrypt argon2ddyn
	scryptn allium lbk3 lyra2 lyra2v2 lyra2z jha qubit zr5 skein sib keccak keccakc hex
	skein2 dmdgr myrgr blake blakecoin decred vanilla blake2s penta rainforest luffa m7m
	veltor velvet vitalium yescrypt yescryptR16 yescryptR32 bastion hsr phi phi2 polytimos
	skunk tribus a5a x16rv2)

# Algos whose stratum config file is named differently.
declare -A ALGO_CONFIG=(
	[sha256]=sha
	[dmdgr]=dmd-gr
	[myrgr]=myr-gr
	[argon2ddyn]=argon2d-dyn
	[neoscrypt]=neo
)

start_stratum() {
	local name=$1
	local config=${ALGO_CONFIG[$name]:-$name}
	if [ ! -f "$STRATUM_DIR/config/${config}.conf" ]; then
		echo "No stratum config found for $name ($STRATUM_DIR/config/${config}.conf)."
		return 1
	fi
	screen -dmS "$name" bash "$STRATUM_DIR/run.sh" "$config"
}

stop_stratum() {
	screen -X -S "$1" quit
}

startstop_stratum() {
	local cmd=$1 name=$2
	case $cmd in
		stop) stop_stratum "$name" ;;
		start) start_stratum "$name" ;;
		restart)
			stop_stratum "$name"
			sleep 1
			start_stratum "$name"
			;;
	esac
}

case "$1" in
	start|stop|restart) cmd=$1 ;;
	*)
		echo "usage: $0 [start|stop|restart] algo"
		echo "known algos: ${ALGOS[*]}"
		exit 1
		;;
esac
shift

for name; do
	if [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
		echo "Invalid algo name: $name"
		continue
	fi
	startstop_stratum "$cmd" "$name"
done
